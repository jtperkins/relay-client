{
    "name": "jtperkins/relay-client",
    "description": "The Laravel client for the study messaging relay: a typed API client, typed refusals, a signed callback route and typed events.",
    "type": "library",
    "license": "proprietary",
    "keywords": ["laravel", "messaging", "relay", "sms"],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.8|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Jtperkins\\RelayClient\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jtperkins\\RelayClient\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Jtperkins\\RelayClient\\RelayClientServiceProvider"
            ],
            "aliases": {
                "Relay": "Jtperkins\\RelayClient\\Facades\\Relay"
            }
        }
    },
    "scripts": {
        "lint": "pint --test",
        "lint:fix": "pint",
        "analyse": "phpstan analyse -c phpstan.neon --no-progress --memory-limit=1G",
        "test": "pest",
        "verify": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
